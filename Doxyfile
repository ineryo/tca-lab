PROJECT_NAME           = "TCA Lab"
PROJECT_BRIEF          = "Algorithms and computational-geometry reference"
PROJECT_NUMBER         = "v1"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
CASE_SENSE_NAMES       = YES
INPUT                  = docs/API_REFERENCE.md \
                         cpp/include/tca \
                         src/tca/algorithms \
                         src/tca/core \
                         src/tca/geometry \
                         src/tca/analysis \
                         src/tca/experiments \
                         src/tca/visualization
FILE_PATTERNS          = *.md *.hpp *.py
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
INCLUDE_PATH           = cpp/include
USE_MDFILE_AS_MAINPAGE = docs/API_REFERENCE.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
HAVE_DOT               = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_FORMAT            = "$file:$line: $text"
QUIET                  = NO
